{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/apps/index",
        "http://127.0.0.1:4173/polymarket-us-politics/state-of-us-politics.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
